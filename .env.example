# =============================================================================
# RustBridge Environment Configuration (.env)
# =============================================================================
# Copy this file to .env and adjust values as needed.
# All RUSTBRIDGE_* variables override values loaded from config.yaml.
# =============================================================================

# Logging & Diagnostic verbosity: trace, debug, info, warn, error
RUST_LOG=info,rustbridge=debug

# Path to YAML configuration file
RUSTBRIDGE_CONFIG=config.yaml

# =============================================================================
# HTTP Server & Networking
# =============================================================================
RUSTBRIDGE_SERVER_HOST=0.0.0.0
RUSTBRIDGE_SERVER_PORT=3000
RUSTBRIDGE_SERVER_METRICS_ENABLED=true

# API Rate Limiting (Sliding Window)
RUSTBRIDGE_SERVER_RATE_LIMIT_ENABLED=true
RUSTBRIDGE_SERVER_RATE_LIMIT_RPM=120

# =============================================================================
# Authentication & Security
# =============================================================================
RUSTBRIDGE_AUTH_ENABLED=false
# Comma-separated list of authorized API keys for X-API-Key header
RUSTBRIDGE_AUTH_API_KEYS=prod-secret-key-1,gateway-token-2

# =============================================================================
# Telemetry Storage & Persistence Layer
# =============================================================================
# Storage backend: "memory" (fast ring-buffer) or "postgres" (relational DB)
RUSTBRIDGE_STORAGE_TYPE=memory
RUSTBRIDGE_STORAGE_MAX_MEMORY_RECORDS=1000
# Required when RUSTBRIDGE_STORAGE_TYPE=postgres:
# RUSTBRIDGE_STORAGE_DATABASE_URL=postgres://rustbridge:rustbridge_dev_password@localhost:5432/rustbridge

# =============================================================================
# MQTT Broker Settings
# =============================================================================
RUSTBRIDGE_MQTT_ENABLED=false
RUSTBRIDGE_MQTT_HOST=localhost
RUSTBRIDGE_MQTT_PORT=1883
RUSTBRIDGE_MQTT_CLIENT_ID=rustbridge-edge
RUSTBRIDGE_MQTT_TOPIC_PREFIX=rustbridge
RUSTBRIDGE_MQTT_QOS=1
RUSTBRIDGE_MQTT_RETAIN=false
# RUSTBRIDGE_MQTT_USERNAME=iot_user
# RUSTBRIDGE_MQTT_PASSWORD=iot_secure_password
RUSTBRIDGE_MQTT_TLS=false
# RUSTBRIDGE_MQTT_CA_FILE=/etc/ssl/certs/ca-certificates.crt

# =============================================================================
# Docker Compose Variables
# =============================================================================
GF_SECURITY_ADMIN_PASSWORD=rustbridge
PROMETHEUS_RETENTION=15d
